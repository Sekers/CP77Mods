<?xml version="1.0"?>
<bindings>
    <!-- inputContexts -->
    <context name="ImprovedMinimapZoomContext" >
        <action name="imzPeek" map="imzPeek_Button" />
    </context>

    <!-- UIExploration, not UIShared: both reach gameplay and every vehicle
         context, but UIShared is also pulled in by UIMenuShared, which made the
         peek key fire inside the map/inventory/pause menus. -->
    <context name="UIExploration" append="true">
        <include name="ImprovedMinimapZoomContext" />
    </context>

    <!-- inputUserMapping -->
    <mapping name="imzPeek_Button" type="Button" >
        <button id="IK_F6" />
    </mapping>

</bindings>
